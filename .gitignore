# .gitignore tells Git "never track these, don't even ask"
# Typical reasons: generated files, secrets, machine-specific junk.
# One pattern per line.

# Dependencies — reinstalled from package.json/requirements.txt, not tracked
node_modules/
venv/
__pycache__/

# Build output — regenerated by a build step, not source
dist/
build/

# Secrets — never belongs in git history, even once
.env
*.pem

# OS/editor noise
.DS_Store
.vscode/
*.log

# Local Claude output folder — facilitator-only material, never for the shared repo
Claude outputs/
